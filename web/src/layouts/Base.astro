---
import '../styles/global.css';
const { title, description = 'Tres herramientas que resuelven dolores reales de una PYME: conciliar caja y banco, generar etiquetas con código de barras y validar listas de precios.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  ['Inicio', base],
  ['Conciliador', base + 'conciliador/'],
  ['Etiquetas', base + 'etiquetas/'],
  ['Precios', base + 'precios/'],
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml">
</head>
<body data-base={base}>
  <header class="site">
    <div class="wrap">
      <a class="logo" href={base}>Automatizaciones <span>PYME</span></a>
      <nav>
        {nav.map(([t, h]) => <a href={h} aria-current={h === base ? (path === base ? 'page' : undefined) : (path.startsWith(h) ? 'page' : undefined)}>{t}</a>)}
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site">
    <div class="wrap">
      Tres soluciones para el día a día de un negocio. Todo corre en tu navegador: los archivos que subís no se envían a ningún servidor.
      <a href="https://github.com/gusdv16/automatizaciones-pyme">Código en GitHub</a>.
    </div>
  </footer>
</body>
</html>
